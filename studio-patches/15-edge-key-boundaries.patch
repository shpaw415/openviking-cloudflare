+/** This handle belongs to the view that initiated a mutation, not its reply. */
+export function useGatewayPresentation(connection: GatewayConnection) {
+  const view = useMemo(() => ({ active: false }), [connection])
+  useLayoutEffect(() => {
+    view.active = true
+    return () => { view.active = false }
+  }, [view])
+  return () => !EDGE_STUDIO || view.active
+}
+
+export function edgeKeyAccessReason(access: GatewayAccess | undefined, connection: Pick<GatewayConnection, 'accountId' | 'userId'>) {
+  if (!access || typeof access.account_id !== 'string' || typeof access.user_id !== 'string') return 'unconfirmed'
+  if (access.account_id !== connection.accountId || access.user_id !== connection.userId) return 'wrongIdentity'
+  if (access.role !== 'user' && access.role !== 'admin') return 'wrongRole'
+  if (access.edge?.dedicated_gateway_keys === false) return 'unmounted'
+  if (access.edge?.dedicated_gateway_keys !== true || keyOwnerPermission(access) === undefined ||
+      (access.role === 'user' && access.can_issue_for_others === true)) return 'unconfirmed'
