--- /dev/null
+++ b/src/shared/lib/edge-capabilities.ts
@@ -0,0 +1,48 @@
+import { allowsStudioApiBase } from './edge-studio'
+
+const keys = ['control', 'packImport', 'packExport', 'searchProvenance', 'bot', 'compile', 'skills', 'snapshots', 'webdav', 'oauth', 'watches'] as const
+export type EdgeFeatures = Partial<Record<(typeof keys)[number], true>>
+
+function record(value: unknown): Record<string, unknown> | undefined {
+  return value !== null && typeof value === 'object' && !Array.isArray(value)
+    ? value as Record<string, unknown> : undefined
+}
+
+export function readEdgeFeatures(payload: unknown): EdgeFeatures {
+  const envelope = record(payload)
+  const flags = record(record(envelope?.result)?.features)
+  if (envelope?.status !== 'ok' || !flags) return {}
+  return Object.fromEntries(keys.filter((flag) => flags[flag] === true).map((flag) => [flag, true]))
+}
+
+export async function fetchEdgeFeatures(baseUrl: string, key: string, signal: AbortSignal): Promise<EdgeFeatures> {
+  const base = new URL(baseUrl)
+  if (!key || base.username || base.password || !allowsStudioApiBase(base)) return {}
+  const response = await fetch(new URL('/api/v1/system/edge-capabilities', base), {
+    headers: { 'X-API-Key': key, Accept: 'application/json' },
+    redirect: 'error',
+    cache: 'no-store',
+    credentials: 'omit',
+    signal: AbortSignal.any([signal, AbortSignal.timeout(8000)]),
+  })
+  if (!response.ok) return {}
+  return readEdgeFeatures(await response.json())
+}
+
+function at(path: string, root: string) {
+  return path === root || path.startsWith(`${root}/`)
+}
+
+/** This is presentation only; the Worker authorizes every request. */
+export function edgeAllowsPage(path: string, flags: EdgeFeatures, canManage: boolean): boolean {
+  if (at(path, '/admin')) {
+    const simple = path.replace(/\/+$/, '')
+    return canManage && (simple === '/admin' || simple === '/admin/users' || simple === '/admin/users/groups')
+  }
+  if (at(path, '/vikingbot')) return flags.bot === true
+  if (at(path, '/compile')) return flags.compile === true
+  if (at(path, '/skills')) return flags.skills === true
+  if (at(path, '/oauth')) return flags.oauth === true
+  if (at(path, '/watches')) return flags.watches === true
+  return ['/home', '/filesystem', '/directory', '/memories', '/retrieval', '/sessions', '/tasks'].some((root) => at(path, root))
+}
