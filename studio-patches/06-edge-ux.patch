new file mode 100644
--- /dev/null
+++ b/src/features/connection/hooks/use-edge-features.tsx
@@ -0,0 +1,37 @@
+import type { ConnectionDraft } from '#/features/connection/lib/types'
+import type { EdgeFeatures } from '#/shared/lib/edge-capabilities'
+import { fetchEdgeFeatures } from '#/shared/lib/edge-capabilities'
+import { createContext, useContext, useEffect, useMemo, useState } from 'react'
+import type { ReactNode } from 'react'
+
+const closed = { flags: {} as EdgeFeatures, pending: false }
+const EdgeFeatureContext = createContext(closed)
+
+export function EdgeFeatureProvider({ connection, management, enabled, children }: {
+  connection: ConnectionDraft
+  management: boolean
+  enabled: boolean
+  children: ReactNode
+}) {
+  const key = (management ? connection.adminApiKey : connection.apiKey).trim()
+  const { accountId, userId, baseUrl } = connection
+  // A new identity per credential change: no reuse of a request from another profile.
+  const identity = useMemo(() => ({ key, baseUrl, accountId, userId, management, enabled }), [key, baseUrl, accountId, userId, management, enabled])
+  const [result, setResult] = useState<{ identity: typeof identity, flags: EdgeFeatures }>()
+  const ready = enabled && !!key && !!baseUrl
+  useEffect(() => {
+    if (!ready) return
+    const controller = new AbortController()
+    const commit = (flags: EdgeFeatures) => {
+      if (!controller.signal.aborted) setResult({ identity, flags })
+    }
+    void fetchEdgeFeatures(identity.baseUrl, identity.key, controller.signal).then(commit, () => commit({}))
+    return () => controller.abort()
+  }, [identity, ready])
+  const current = result?.identity === identity ? result : undefined
+  return <EdgeFeatureContext.Provider value={ready ? { flags: current?.flags ?? closed.flags, pending: !current } : closed}>{children}</EdgeFeatureContext.Provider>
+}
+
+export function useEdgeFeatures() {
+  return useContext(EdgeFeatureContext)
+}
