diff --git a/src/features/workbench/resources/hooks/use-approved-url-import.ts b/src/features/workbench/resources/hooks/use-approved-url-import.ts
new file mode 100644
index 0000000..261e92c
--- /dev/null
+++ b/src/features/workbench/resources/hooks/use-approved-url-import.ts
@@ -0,0 +1,196 @@
+import { useCallback, useLayoutEffect, useRef, useState } from 'react'
+import { postResourceImport } from '#/features/workbench/resources/lib/resource-import-api'
+import type { OvClientAdapter } from '#/shared/api/ov-client/index'
+import { getOvResult, getTaskByTaskId, normalizeOvClientError } from '#/shared/api/ov-client/index'
+
+export type ApprovedUrlDraft = { url: string; mode: 'parent' | 'to'; destination: string }
+type Task = { id: string; uri: string }
+type Refusal = 'source' | 'sourceTimeout' | 'destination' | 'request'
+type Interruption = 'unavailable' | 'timeout' | 'paused'
+type State =
+  | { phase: 'idle' }
+  | { phase: 'submitting' | 'unknown'; draft: ApprovedUrlDraft }
+  | { phase: 'rejected'; draft: ApprovedUrlDraft; refusal: Refusal }
+  | { phase: 'interrupted'; draft: ApprovedUrlDraft; task: Task; reason: Interruption }
+  | { phase: 'tracking' | 'done' | 'failed' | 'cancelled'; draft: ApprovedUrlDraft; task: Task }
+
+const SOURCE_SUFFIX = /\.(md|txt|csv|json)$/i
+const RESOURCE_ROOT = /^viking:\/\/(?:resources|~\/resources|user\/[\w-]+\/resources)(?:\/|$)/
+const TRACK_FOR = 30_000
+const SUBMIT_FOR = 15_000
+const POLL_EVERY = 2_000
+
+export function isApprovedUrlShape(value: string) {
+  // This is a field check, not authorization. Never submit a normalized href in place of the draft.
+  try {
+    const url = new URL(value)
+    return value.length <= 1000 && url.href === value && url.protocol === 'https:' &&
+      !url.username && !url.password && !url.port && !/[?#]/.test(value) &&
+      url.hostname.length <= 253 &&
+      /^(?:[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?\.)+[a-z][a-z0-9-]{0,62}$/.test(url.hostname) &&
+      !/(?:^|\.)(?:localhost|internal|local|lan|home|arpa)(?:\.|$)/.test(url.hostname) &&
+      url.pathname.slice(1).split('/').every(part => /^[A-Za-z0-9_-][A-Za-z0-9_.-]{0,159}$/.test(part)) &&
+      SOURCE_SUFFIX.test(url.pathname)
+  } catch { return false }
+}
+
+export function isApprovedDestinationShape({ mode, destination }: ApprovedUrlDraft) {
+  if (mode === 'parent' && destination === '') return true
+  if (!RESOURCE_ROOT.test(destination) || destination !== destination.trim()) return false
+  return mode === 'parent' || SOURCE_SUFFIX.test(destination) && !destination.split('/').at(-1)?.startsWith('.')
+}
+
+function record(value: unknown): Record<string, unknown> | undefined {
+  return value !== null && typeof value === 'object' && !Array.isArray(value)
+    ? value as Record<string, unknown> : undefined
+}
+
+function acceptedTask(result: Record<string, unknown> | undefined): Task | undefined {
+  if ((result?.status === 'accepted' || result?.status === 'success') &&
+      typeof result.task_id === 'string' && /^[a-f0-9]{8}(?:-[a-f0-9]{4}){3}-[a-f0-9]{12}$/.test(result.task_id) &&
+      typeof result.root_uri === 'string' && RESOURCE_ROOT.test(result.root_uri) && SOURCE_SUFFIX.test(result.root_uri)) {
+    return { id: result.task_id, uri: result.root_uri }
+  }
+}
+
+function refusalKind(error: unknown): Refusal | undefined {
+  const { code, statusCode } = normalizeOvClientError(error)
+  if (code === 'DEADLINE_EXCEEDED') return 'sourceTimeout'
+  if (code === 'SOURCE_UNAVAILABLE' || code === 'UNSUPPORTED_MEDIA_TYPE') return 'source'
+  if (['INVALID_URI', 'RESOURCE_BUSY', 'ALREADY_EXISTS', 'NOT_FOUND', 'CONFLICT'].includes(code)) return 'destination'
+  if (statusCode && statusCode >= 400 && statusCode < 500 || code === 'NOT_IMPLEMENTED' || code === 'EMBEDDING_UNAVAILABLE') return 'request'
+  // No authoritative rejection: even a dropped POST response may hide a committed admission.
+}
+
+type Operation = { abort: AbortController; clock?: number; next?: number }
+type Viewer = { onCompleted: () => void }
+
+/** One pending import scoped to the existing Workspace provider, never to a global task list. */
+export function useApprovedUrlImport(client: OvClientAdapter['client'], isCurrent: () => boolean) {
+  const [state, setState] = useState<State>({ phase: 'idle' })
+  const latest = useRef<State>({ phase: 'idle' })
+  const operation = useRef<Operation | null>(null)
+  const viewer = useRef<Viewer | null>(null)
+
+  const publish = useCallback((value: State) => {
+    latest.current = value
+    setState(value)
+  }, [])
+
+  const stop = useCallback(() => {
+    const active = operation.current
+    operation.current = null
+    if (!active) return
+    window.clearTimeout(active.next)
+    window.clearTimeout(active.clock)
+    active.abort.abort()
+  }, [])
+
+  useLayoutEffect(() => stop, [stop])
+
+  const follow = useCallback((draft: ApprovedUrlDraft, task: Task) => {
+    if (!isCurrent() || !viewer.current || operation.current) return
+    const active: Operation = { abort: new AbortController() }
+    const current = () => operation.current === active && isCurrent() && viewer.current !== null
+    operation.current = active
+    publish({ phase: 'tracking', draft, task })
+    const interrupt = (reason: Interruption) => {
+      if (!current()) return
+      stop()
+      publish({ phase: 'interrupted', draft, task, reason })
+    }
+    active.clock = window.setTimeout(() => interrupt('timeout'), TRACK_FOR)
+    const read = async () => {
+      if (!current()) return
+      try {
+        const status = record(await getOvResult(getTaskByTaskId({
+          client, signal: active.abort.signal, path: { task_id: task.id },
+        })))
+        if (!current()) return
+        if (!status || status.task_id !== task.id || status.task_type !== 'add_resource' || status.resource_id !== task.uri) {
+          interrupt('unavailable')
+          return
+        }
+        if (status.status === 'pending' || status.status === 'running' || status.status === 'cancelling') {
+          active.next = window.setTimeout(() => void read(), POLL_EVERY)
+          return
+        }
+        if (status.status === 'failed' || status.status === 'cancelled') {
+          stop()
+          publish({ phase: status.status, draft, task })
+          return
+        }
+        const result = record(status.result)
+        if (status.status === 'completed' && result?.status === 'success' && result.root_uri === task.uri) {
+          stop()
+          publish({ phase: 'done', draft, task })
+          viewer.current?.onCompleted()
+          return
+        }
+        interrupt('unavailable')
+      } catch { interrupt('unavailable') }
+    }
+    void read()
+  }, [client, isCurrent, publish, stop])
+
+  const attach = useCallback((onCompleted: () => void) => {
+    const current = { onCompleted }
+    viewer.current = current
+    return () => {
+      if (viewer.current !== current) return
+      viewer.current = null
+      const value = latest.current
+      if (value.phase !== 'tracking') return
+      stop()
+      if (isCurrent()) publish({ ...value, phase: 'interrupted', reason: 'paused' })
+      // An in-flight POST may already have been admitted. Leave its bounded receipt
+      // reader alive under this Workspace only, so reopening can recover its task ID.
+    }
+  }, [isCurrent, publish, stop])
+
+  const start = useCallback((draft: ApprovedUrlDraft) => {
+    if (!isCurrent() || !viewer.current || operation.current ||
+        !['idle', 'rejected', 'done', 'failed', 'cancelled'].includes(latest.current.phase)) return
+    const active: Operation = { abort: new AbortController() }
+    const current = () => operation.current === active && isCurrent()
+    operation.current = active
+    publish({ phase: 'submitting', draft })
+    active.clock = window.setTimeout(() => {
+      if (!current()) return
+      stop()
+      publish({ phase: 'unknown', draft })
+    }, SUBMIT_FOR)
+    void (async () => {
+      try {
+        const result = await getOvResult(postResourceImport({
+          path: draft.url, [draft.mode]: draft.destination || 'viking://~/resources',
+          wait: false, processing_mode: 'vectors_only',
+        }, { client, signal: active.abort.signal }))
+        if (!current()) return
+        stop()
+        const task = acceptedTask(record(result))
+        if (!task) publish({ phase: 'unknown', draft })
+        else if (viewer.current) follow(draft, task)
+        else publish({ phase: 'interrupted', draft, task, reason: 'paused' })
+      } catch (error) {
+        if (!current()) return
+        stop()
+        const refusal = refusalKind(error)
+        publish(refusal ? { phase: 'rejected', draft, refusal } : { phase: 'unknown', draft })
+      }
+    })()
+  }, [client, isCurrent, publish, follow, stop])
+
+  const resume = useCallback(() => {
+    const value = latest.current
+    if (value.phase === 'interrupted') follow(value.draft, value.task)
+  }, [follow])
+
+  const clearTerminal = useCallback(() => {
+    if (isCurrent() && ['rejected', 'done', 'failed', 'cancelled'].includes(latest.current.phase)) {
+      publish({ phase: 'idle' })
+    }
+  }, [isCurrent, publish])
+
+  return { state, attach, start, resume, clearTerminal }
+}
