diff --git a/src/features/admin/gateway/lib/edge-key-catalog.ts b/src/features/admin/gateway/lib/edge-key-catalog.ts
new file mode 100644
--- /dev/null
+++ b/src/features/admin/gateway/lib/edge-key-catalog.ts
@@ -0,0 +1,15 @@
+import type { Protocol, Upstream } from '#/features/admin/gateway/lib/api'
+import { edgeRoutableModels } from '#/features/admin/gateway/lib/use-gateway'
+
+/** The server's effective catalog, scoped to the actual rules and key. */
+export function edgeKeyModels(
+  upstreams: Upstream[],
+  selected: string[],
+  allowed: string[] = [],
+  protocol?: Protocol,
+): string[] {
+  return [...new Set(upstreams
+    .filter((rule) => selected.includes(rule.id) && (!protocol || rule.protocol === protocol))
+    .flatMap(edgeRoutableModels)
+    .filter((name) => !allowed.length || allowed.includes(name)))].sort()
+}
