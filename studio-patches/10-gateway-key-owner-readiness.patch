+/** Permissions come from an API response; unknown is not the self-only grant. */
+export function keyOwnerPermission(access: unknown): boolean | undefined {
+  if (!access || typeof access !== 'object' || !('can_issue_for_others' in access)) {
+    return undefined
+  }
+  const permission = access.can_issue_for_others
+  return typeof permission === 'boolean' ? permission : undefined
+}
+
+/** Start the scoped directory read on authorization, not on the next form paint. */
+export function useKeyUsers(
+  open: boolean,
+  accessQuery: ReturnType<typeof useAccess>,
+) {
+  const { allowed, connection, scope } = useGatewayConnection()
+  const queryClient = useQueryClient()
+  const queryKey = gatewayQueryKey(scope, 'users')
+  return useQuery<KeyUser[], GatewayError>({
+    queryKey,
+    enabled:
+      open &&
+      allowed &&
+      (accessQuery.isPending ||
+        (accessQuery.isSuccess && keyOwnerPermission(accessQuery.data) === true)),
+    queryFn: async ({ signal }) => {
+      if (!allowed) throw new Error(i18n.t('studio:errors.gatewayUnavailable'))
+      // Join the existing access request/cache for the same account and keys.
+      const access = await queryClient.fetchQuery({
+        ...accessCacheOptions,
+        queryKey: gatewayQueryKey(scope, 'access'),
+        queryFn: () => getAccess(connection),
+      })
+      if (signal.aborted) return []
+      if (
+        keyOwnerPermission(access) !== true ||
+        !queryClient.getQueryCache().find({ queryKey, exact: true })?.isActive()
+      ) {
+        // No directory result exists. Revert rather than cache a synthetic empty list.
+        void queryClient.cancelQueries({ queryKey, exact: true })
+        return []
+      }
+      return listKeyUsers(connection)
+    },
+  })
+}
