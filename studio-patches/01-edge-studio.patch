new file mode 100644
--- /dev/null
+++ b/src/shared/lib/edge-studio.ts
@@ -0,0 +1,14 @@
+export const EDGE_STUDIO = import.meta.env.VITE_STUDIO_EDGE === 'true'
+
+/** This artifact does not accept a remote API origin or an API subpath. */
+export function allowsStudioApiBase(url: URL): boolean {
+  return (
+    !EDGE_STUDIO ||
+    (typeof window !== 'undefined' &&
+      url.origin === window.location.origin &&
+      url.pathname === '/' &&
+      !url.search &&
+      !url.hash)
+  )
+}
