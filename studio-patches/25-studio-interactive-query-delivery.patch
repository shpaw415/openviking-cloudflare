new file mode 100644
--- /dev/null
+++ b/src/shared/hooks/use-query-settlement.ts
@@ -0,0 +1,24 @@
+import { useQueryClient } from '@tanstack/react-query'
+import type { QueryKey } from '@tanstack/react-query'
+import { useCallback, useSyncExternalStore } from 'react'
+
+/**
+ * Let an interactive view consume a settled cache entry without waiting for
+ * the query observer's scheduled notification. The observer still owns all
+ * fetching, polling and errors. Do not change the global notification queue.
+ */
+export function useQuerySettlement(queryKey: QueryKey, enabled: boolean) {
+  const client = useQueryClient()
+  const cache = client.getQueryCache()
+  const hash = client.defaultQueryOptions({ queryKey }).queryHash
+  const subscribe = useCallback((update: () => void) => {
+    if (!enabled) return () => {}
+    return cache.subscribe(event => {
+      if (event.type === 'updated' && event.query.queryHash === hash &&
+          (event.action.type === 'success' || event.action.type === 'error')) update()
+    })
+  }, [cache, enabled, hash])
+  const snapshot = useCallback(() => enabled && hash !== undefined ? cache.get(hash)?.state : undefined,
+    [cache, enabled, hash])
+  useSyncExternalStore(subscribe, snapshot, () => undefined)
+}
